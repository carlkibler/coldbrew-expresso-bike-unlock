127.0.0.1	localhost
127.0.1.1	station

# The following lines are desirable for IPv6 capable hosts
::1     ip6-localhost ip6-loopback
fe00::0 ip6-localnet
ff00::0 ip6-mcastprefix
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters

# Coldbrew: blackhole phone-home endpoints. These hosts DO still resolve
# (AWS ELB returns HTTP 200 in ~100ms) but we don't want any phone-home,
# and if the ELB ever goes down the game's connect timeout could stall
# boot by many seconds. Pointing to 127.0.0.1 (nothing listening) gives
# an immediate ECONNREFUSED. Pair with TimeoutUserLoginSeconds = 1.
127.0.0.1	services.expresso.net
127.0.0.1	updates.expresso.net
